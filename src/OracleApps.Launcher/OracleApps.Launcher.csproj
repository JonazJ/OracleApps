<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OracleApps.Launcher</RootNamespace>
    <AssemblyName>OracleApps.Launcher</AssemblyName>
    <Product>Oracle Apps Launcher</Product>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="[4.61.3,5.0.0)" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="[4.61.3,5.0.0)" />
    <PackageReference Include="System.Drawing.Common" Version="[8.0.0,9.0.0)" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="[8.0.0,9.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config\apps.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\background.png" />
  </ItemGroup>

</Project>
