<Window x:Class="OracleApps.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OracleApps.Launcher.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding Title}"
        Height="780" Width="1200" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI"
        Background="{StaticResource FallbackBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootLayout">
        <!-- Background picture with a dark scrim so the tiles stay readable -->
        <Rectangle Fill="{StaticResource FallbackBackgroundBrush}" />
        <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill" />
        <Rectangle Fill="{StaticResource ScrimBrush}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Height="44">
                <TextBlock Text="Oracle Apps Launcher" Margin="20,0,0,0"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            ToolTip="Minimise" Click="OnMinimize" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            ToolTip="Maximise" Click="OnMaximizeRestore" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;"
                            ToolTip="Close" Click="OnClose" />
                </StackPanel>
            </Grid>

            <!-- Header -->
            <Grid Grid.Row="1" Margin="36,18,36,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleText}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource ChipBrush}" CornerRadius="24"
                            BorderBrush="#26FFFFFF" BorderThickness="1" Padding="6,6,18,6"
                            Visibility="{Binding User, Converter={StaticResource NotNullToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="36" Height="36">
                                <Ellipse Fill="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding User.Initials}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Visibility="{Binding User.Photo, Converter={StaticResource NullToVisibility}}" />
                                <Ellipse Visibility="{Binding User.Photo, Converter={StaticResource NotNullToVisibility}}">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding User.Photo}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding User.DisplayName}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding User.Email}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding User.Email, Converter={StaticResource NotNullToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource GhostButton}" Content="Refresh" Margin="12,0,0,0"
                            Command="{Binding RefreshCommand}" ToolTip="Look for the apps again" />
                    <Button Style="{StaticResource GhostButton}" Content="Sign out" Margin="8,0,0,0"
                            Command="{Binding SignOutCommand}" />
                </StackPanel>
            </Grid>

            <!-- App tiles -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Padding="36,0,24,0" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="304" Height="168" Margin="0,0,20,20">
                                <Button Style="{StaticResource TileButton}"
                                        Command="{Binding LaunchCommand}"
                                        IsEnabled="{Binding CanLaunch}"
                                        ToolTip="{Binding Details}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Border Width="52" Height="52" CornerRadius="12"
                                                    Background="{Binding AccentBrush}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initials}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="19" FontWeight="Bold" Foreground="White"
                                                               Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}}" />
                                                    <Image Source="{Binding Icon}" Width="34" Height="34"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding Icon, Converter={StaticResource NotNullToVisibility}}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="14,0,0,0"
                                                       VerticalAlignment="Center" Width="180"
                                                       FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Text="{Binding Description}" Margin="0,12,0,0"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   FontSize="12" LineHeight="17"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{Binding StatusBrush}" />
                                            <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{Binding StatusBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Sits beside the tile button so it stays clickable while the tile is disabled -->
                                <Button Style="{StaticResource LinkButton}" Content="Get the app"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,20,20"
                                        Command="{Binding InstallCommand}"
                                        Visibility="{Binding HasInstallUrl, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="36,10,36,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="80" Height="3" IsIndeterminate="True" BorderThickness="0"
                                 Background="Transparent" Foreground="{StaticResource AccentBrush}"
                                 Margin="0,0,12,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button Style="{StaticResource GhostButton}" Content="Edit app list"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding EditConfigCommand}"
                        ToolTip="Open apps.json to add or change apps" />
            </Grid>

            <!-- Sign-in overlay: leaves the title bar reachable -->
            <Border Grid.Row="1" Grid.RowSpan="3" Background="#F00A1020"
                    Visibility="{Binding ShowSignIn, Converter={StaticResource BoolToVisibility}}">
                <Border Width="440" CornerRadius="16" Padding="40"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource CardBrush}" BorderBrush="#26FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <UniformGrid Rows="2" Columns="2" Width="34" Height="34" HorizontalAlignment="Left">
                            <Rectangle Fill="#F25022" Margin="0,0,2,2" />
                            <Rectangle Fill="#7FBA00" Margin="2,0,0,2" />
                            <Rectangle Fill="#00A4EF" Margin="0,2,2,0" />
                            <Rectangle Fill="#FFB900" Margin="2,2,0,0" />
                        </UniformGrid>

                        <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" Margin="0,24,0,0" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleText}" />

                        <Button Style="{StaticResource PrimaryButton}" Content="Sign in with Microsoft"
                                Margin="0,28,0,0" HorizontalAlignment="Stretch"
                                Command="{Binding SignInCommand}" />

                        <Button Style="{StaticResource LinkButton}" Content="Continue without signing in"
                                Margin="0,18,0,0" HorizontalAlignment="Center"
                                Command="{Binding ContinueLocallyCommand}"
                                Visibility="{Binding AllowLocalMode, Converter={StaticResource BoolToVisibility}}" />

                        <ProgressBar Height="3" Margin="0,20,0,0" IsIndeterminate="True" BorderThickness="0"
                                     Background="Transparent" Foreground="{StaticResource AccentBrush}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding SignInMessage}" Margin="0,16,0,0" TextWrapping="Wrap"
                                   FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
